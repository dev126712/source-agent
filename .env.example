# Copy to `.env` and fill in only what you need. docker-compose reads it
# automatically (required: false — the stack runs without it on mocks).
#
#   cp .env.example .env

# --- app ---
DEPLOYMENT_ENV=dev            # dev | staging | prod (also picks the default LLM)
LOG_LEVEL=INFO

# --- data providers ---
AMAZON_PROVIDER=mock          # mock | keepa | sp_api
# KEEPA_API_KEY=

# --- retailer adapters ---
# Setting a key registers that adapter and switches discovery off the mock.
# Best Buy: https://developer.bestbuy.com/ (new keys require a company email
# domain, not gmail/yahoo). NOTE: US-only — expects a 2-letter US state code as
# the region, so it cannot serve the Canadian provinces the UI ships today.
# BESTBUY_API_KEY=
# BESTBUY_BASE_URL=https://api.bestbuy.com/v1
# RETAILER_TIMEOUT_SECONDS=10

# --- LLM (optional; provider defaults by DEPLOYMENT_ENV: groq in dev, anthropic in prod) ---
# LLM_PROVIDER=anthropic      # anthropic | openai | groq | ollama
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# --- infra overrides (compose already sets these to the service hostnames) ---
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/sourcing
# REDIS_URL=redis://redis:6379/0
